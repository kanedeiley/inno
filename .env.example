# Azure AI Foundry / Azure OpenAI resource
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=

# Chat + ticket extraction deployment (exact deployment name, e.g. gpt-4o or gpt-4o-mini)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21

# Realtime (voice) deployment
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
# "ga"      -> wss://<resource>/openai/v1/realtime?model=<deployment>   (gpt-realtime)
# "preview" -> wss://<resource>/openai/realtime?api-version=...&deployment=<deployment>  (gpt-4o-realtime-preview)
AZURE_OPENAI_REALTIME_API=ga
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview
# Optional: full wss:// URL override if your Foundry endpoint differs
AZURE_OPENAI_REALTIME_URL=
REALTIME_VOICE=alloy
REALTIME_TRANSCRIBE_MODEL=whisper-1

PORT=3001
